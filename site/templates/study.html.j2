{# One study (plan, step 23): signals, our text (verified or fallback), metadata, link to
   the original and every licence. Never the abstract. From the «Noche» mock-up
   (spikes/web/v3/templates/study.html.j2). Figure 1 of the original when it has one
   (step 23b). #}
{% extends "base.html.j2" %}
{% import "macros.html.j2" as m with context %}
{% block title %}{{ title(s).text | truncate(60) }}{% endblock %}
{% block main %}
<article class="study" data-study="{{ s.study_id }}">
  <p class="back"><a href="{{ url('news') }}">← {{ t.back }}</a></p>
  {{ m.kicker(s) }}
  {% set tt = title(s) %}
  <h1 class="study-title" lang="{{ tt.lang }}">{{ tt.text }}</h1>
  {% if tt.translated %}<p class="title-note">{{ t.title_translated }} <span lang="en">{{ s.title }}</span></p>
  {% elif lang == "es" %}<p class="title-note">{{ t.title_original }} {{ m.gap("title_es") }}</p>{% endif %}
  {{ m.signals_full(s) }}
  <div class="study-body">
    {{ m.summary(s, full=True) }}
    {% if s.url %}<p><a class="button" href="{{ s.url }}" rel="noopener" target="_blank">{{ t.original }} ↗</a></p>{% endif %}
  </div>
  {% if s.figure %}<div class="study-fig">{{ m.figure(s, "full", lazy=True) }}</div>{% endif %}
  {{ m.meta_table(s) }}
  <section class="study-lic" aria-labelledby="lic-h">
    <h2 id="lic-h">{{ t.licences }}</h2>
    <ul class="licences">{% for l in licence(s) %}<li>{{ l }}</li>{% endfor %}</ul>
  </section>
</article>
{% endblock %}
