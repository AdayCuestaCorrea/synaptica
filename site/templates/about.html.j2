{# «Sobre nosotros» / «About us» (plan, step 22). #}
{% extends "base.html.j2" %}
{% import "macros.html.j2" as m with context %}
{% block title %}{{ t.about }}{% endblock %}
{% block main %}
<article class="prose">
  <h1>{{ t.about }}</h1>
  <p class="draft">{{ t.draft }} · {{ m.gap("about_intro") }}</p>
  {% include "text/about_" ~ lang ~ ".html.j2" %}
  <p><a href="{{ url('method') }}">{{ t.method }} →</a></p>
</article>
{% endblock %}
