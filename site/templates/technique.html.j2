{# A technique of Neuro Lab (SCOPE §4; B2 of v202, option A): what the warehouse already
   holds (recent studies by MeSH or text, marked as a proposal); the texts are gaps until
   Sofía reviews them. Her three parts (sheet row 15, v252): a general description («what it
   lets us see» and «limits»), the protocol with its illustration, and the recent studies. #}
{% extends "base.html.j2" %}
{% import "macros.html.j2" as m with context %}
{% block title %}{{ name }} · {{ t.lab }}{% endblock %}
{% block main %}
<article class="prose technique">
  <p class="crumbs"><a href="{{ url('lab') }}">{{ t.lab }}</a></p>
  <h1>{{ name }}</h1>

  <h2>{{ t.lab_overview_h }}</h2>
  {% for kind, head in (("what", t.lab_what_h), ("limit", t.lab_limits_h)) %}
  <h3>{{ head }}</h3>
  {% if kind in texts %}{% set x = texts[kind] %}
  <p data-lab-text="{{ kind }}">{{ x[lang] }}</p>
  <p class="muted lab-review">{{ t["lab_reviewed_" ~ x.mark].format(date=date(x.reviewed_at)) }} ·
    {% if x.source.get("kind") == "pmc" %}{% set c = x.source.citation %}{{ t.gl_source }} <span lang="en">{{ c.authors }}</span> ({{ c.year }}). <a href="{{ x.source.url }}" rel="noopener" lang="en">«{{ c.title }}»</a>, <i lang="en">{{ c.journal }}</i>, {{ t.lab_pmc_section.format(heading=x.source.heading) }} · {{ x.source.licence | upper if x.source.licence else t.lab_pmc_no_licence }}</p>
    {%- else %}{{ t.gl_source }} <a href="{{ x.source.url }}" rel="noopener" lang="en">Wikipedia ({{ t.lang_en }}): «{{ x.source.title }}»</a> · CC BY-SA 4.0</p>{% endif %}
  {% else %}
  <p class="muted">{{ m.gap("lab_texts") }}</p>
  {% endif %}
  {% endfor %}

  <h2>{{ t.lab_protocol_h }}</h2>
  {% if image %}
  <figure class="fig fig--full lab-figure" data-figure-credit="{{ image.author }}">
    <img src="{{ static('img/lab/' ~ image.webp) }}" alt="{{ t.lab_image_alt.format(name=name) }}" width="{{ image.width }}" height="{{ image.height }}" loading="lazy" decoding="async">
    <figcaption class="credit">{{ image.author }} · {% if image.licence_url %}<a href="{{ image.licence_url }}" rel="license noopener" target="_blank">{{ image.licence }}</a>{% else %}{{ image.licence }}{% endif %} · <a href="{{ image.source_url }}" rel="noopener" target="_blank">Wikimedia Commons</a></figcaption>
  </figure>
  {% endif %}
  {% if "protocol" in texts %}{% set x = texts["protocol"] %}
  <p data-lab-text="protocol">{{ x[lang] }}</p>
  <p class="muted lab-review">{{ t["lab_reviewed_" ~ x.mark].format(date=date(x.reviewed_at)) }} ·
    {{ t.gl_source }} <a href="{{ x.source.url }}" rel="noopener" lang="en">Wikipedia ({{ t.lang_en }}): «{{ x.source.title }}»</a> · CC BY-SA 4.0</p>
  {% else %}
  <p class="muted">{{ m.gap("lab_protocol") }}</p>
  {% endif %}

  <h2>{{ t.lab_studies_h }}{% if groups is not none %} {{ m.gap_if("lab_match") }}{% endif %}</h2>
  {% if groups is none %}
  <p class="muted">{{ m.gap("lab_studies") }}</p>
  {% elif not groups %}
  <p class="muted">{{ t.lab_studies_none }}</p>
  {% else %}
  {% if reviewed_at %}<p class="muted region-reviewed">{{ t.lab_match_reviewed | replace("{date}", reviewed_at) }}</p>{% endif %}
  <p class="muted">{{ t.lab_studies_intro }}{% if lang == "es" %} {{ m.gap_if("title_es") }}{% endif %}</p>
  {% for g in groups %}
  <section class="region-studies" data-species="{{ g.species }}">
    <h3>{{ t.region_sp_unknown if g.species == "unknown" else t["sp_" ~ g.species] }} <span class="count">({{ g.total }})</span></h3>
    {% for s in g.studies %}
    <article class="row" data-study="{{ s.study_id }}">
      <div class="row-text">
        {{ m.kicker(s) }}
        <h4 class="row-title">{% if s.study_id in study_pages %}<a href="{{ url('study', s.slug) }}" lang="en">{{ s.title }}</a>{% elif s.url %}<a href="{{ s.url }}" rel="noopener" lang="en">{{ s.title }}</a>{% else %}<span lang="en">{{ s.title }}</span>{% endif %}</h4>
        {{ m.chips(s) }}
      </div>
    </article>
    {% endfor %}
    {% if g.more %}<p class="muted">{{ t.region_more.format(n=g.more) }}</p>{% endif %}
  </section>
  {% endfor %}
  {% endif %}

</article>
{% endblock %}
