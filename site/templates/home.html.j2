{# Home page, step 21: hero and the six sections. «Today» and the topics come with
   step 23. From the «Noche» mock-up (spikes/web/v3/templates/index.html.j2). #}
{% extends "base.html.j2" %}
{% import "macros.html.j2" as m with context %}
{% block title %}{{ t.hub }}{% endblock %}
{% block main %}
<section class="hero">
  <div class="hero-text">
    <h1>{{ t.hub }}</h1>
    <p>{{ t.hub_sub }}</p>
  </div>
  <div class="hero-photo">
    <img class="hero-img--dark" src="{{ static('img/cabecera-cerebro-oscuro.webp') }}" width="893" height="461" alt="{{ t.hero_alt }}" decoding="async" data-credit="credit-hero">
    <img class="hero-img--light" src="{{ static('img/cabecera-cerebro-claro.webp') }}" width="893" height="461" alt="{{ t.hero_alt }}" decoding="async" data-credit="credit-hero">
  </div>
</section>

<section class="sections" aria-label="{{ t.explore }}">
  {% for sec in sections %}
  {% if sec.key == "atlas" %}
  <a class="card card--atlas" href="{{ atlas_url }}" rel="noopener" target="_blank">
    <span class="card-title">{{ sec.name }}</span>
    <span class="card-art">{{ m.art("atlas") }}</span>
    <span class="card-text">{{ t["sec_" ~ sec.key] }} ↗</span>
    <span class="tag tag--live">{{ t.preview }}</span>
  </a>
  {% else %}
  <div class="card card--{{ sec.key }} card--soon">
    <span class="card-title">{{ sec.name }}</span>
    <span class="card-art">{{ m.art(sec.key) }}</span>
    <span class="card-text">{{ t["sec_" ~ sec.key] }}</span>
    <span class="tag">{{ t.soon_phase.format(n=sec.phase) }}<span class="soon-word"> · {{ t.soon_word }}</span></span>
  </div>
  {% endif %}
  {% endfor %}
</section>
{% endblock %}
{% block footer_images %}
<p id="credit-hero">{{ t.footer_hero.format(author=hero_author, licence=hero_licence) }}{% if "hero_licence" in gaps %} {{ m.gap("hero_licence") }}{% endif %}</p>
{% endblock %}
