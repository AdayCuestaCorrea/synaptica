{# A region of Neuro Atlas (step 5, SCOPE v166; UX-2 C: the full page next to the viewer's
   short card). Option B of Aday: only the regions of the rat ↔ human pairs, with what the
   atlas data already hold; what is not written yet is a gap, never filled by guess. #}
{% extends "base.html.j2" %}
{% import "macros.html.j2" as m with context %}
{% block title %}{{ r.name }} · {{ t.atlas }}{% endblock %}
{% block main %}
<article class="prose region">
  <p class="crumbs"><a href="{{ url('atlas') }}">{{ t.atlas }}</a> › {{ t["brain_" ~ r.brain] }}</p>
  <h1><span lang="en">{{ r.name }}</span>{% if r.acronym %} <span class="acr">{{ r.acronym }}</span>{% endif %}</h1>
  <p class="region-facts">
    <span class="swatch-label">{{ t["brain_" ~ r.brain] }}</span> · {{ t["fam_" ~ r.family] }}
    {% if lang == "es" %} · {{ m.gap("atlas_names") }}{% endif %}
  </p>
  <p><a class="btn-link" href="{{ url('atlas') }}#{{ r.key }}">{{ t.region_view }} →</a></p>

  <h2>{{ t.region_text_h }}</h2>
  {% for x in texts %}
  <p data-region-text="{{ x.kind }}">{{ x[lang] }}</p>
  {% if x.whole %}<p class="muted">{{ t.region_text_whole }}</p>{% endif %}
  <p class="muted lab-review">{{ t["lab_reviewed_" ~ x.mark].format(date=date(x.reviewed_at)) }} ·
    {{ t.gl_source }} <a href="{{ x.source.url }}" rel="noopener" lang="en">Wikipedia ({{ t.lang_en }}): «{{ x.source.title }}»</a> · CC BY-SA 4.0</p>
  {% else %}
  <p class="muted">{{ m.gap("region_text") }}</p>
  {% endfor %}

  <h2>{{ t.region_pair_h.format(brain=t["brain_" ~ ("human" if r.brain == "rat" else "rat")] | lower) }}</h2>
  {% for p in r.pairs %}
  <ul class="pair-list">
    {% for key in p.counterparts %}{% set c = by_page[key] %}
    <li><a href="{{ url('region', c.page) }}" lang="en">{{ c.name }}</a>{% if c.acronym %} <span class="acr">{{ c.acronym }}</span>{% endif %}</li>
    {% endfor %}
  </ul>
  <p>{{ t.grade }}: {% if p.grade %}<strong>{{ t["grade_" ~ p.grade] }}</strong>{% else %}{{ t.grade_pending }} {{ m.gap("pair_grade") }}{% endif %}</p>
  {% if p.note %}<p>{{ p.note }}</p>{% endif %}
  {% endfor %}

  <h2>{{ t.region_studies_h }}{% if groups is not none %} {{ m.gap_if("region_match") }}{% endif %}</h2>
  {% if groups is none %}
  <p class="muted">{{ m.gap("region_studies") }}</p>
  {% elif not groups %}
  <p class="muted">{{ t.region_studies_none }}</p>
  {% else %}
  {% if reviewed_at %}<p class="muted region-reviewed">{{ t.region_match_reviewed | replace("{date}", reviewed_at) }}</p>{% endif %}
  <p class="muted">{{ t.region_studies_intro }}{% if lang == "es" %} {{ m.gap_if("title_es") }}{% endif %}</p>
  {% for g in groups %}
  <section class="region-studies" data-species="{{ g.species }}">
    <h3>{{ t.region_sp_unknown if g.species == "unknown" else t["sp_" ~ g.species] }} <span class="count">({{ g.total }})</span></h3>
    {% for s in g.studies %}
    <article class="row" data-study="{{ s.study_id }}">
      <div class="row-text">
        {{ m.kicker(s) }}
        <h4 class="row-title">{% if s.study_id in study_pages %}<a href="{{ url('study', s.slug) }}" lang="en">{{ s.title }}</a>{% elif s.url %}<a href="{{ s.url }}" rel="noopener" lang="en">{{ s.title }}</a>{% else %}<span lang="en">{{ s.title }}</span>{% endif %}</h4>
        {{ m.chips(s) }}
      </div>
    </article>
    {% endfor %}
    {% if g.more %}<p class="muted">{{ t.region_more.format(n=g.more) }}</p>{% endif %}
  </section>
  {% endfor %}
  {% endif %}
  <h2>{{ t.region_diseases_h }}</h2>
  <p class="muted">{{ m.gap("region_diseases") }}</p>

  <p class="region-credit">{{ t.atlas_credit }}: <a href="{{ credit.source_url }}" rel="noopener">{{ credit.short }}</a> · <a href="{{ credit.licence_url }}" rel="noopener license">{{ credit.licence }}</a></p>
</article>
{% endblock %}
