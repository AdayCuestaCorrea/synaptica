   "title_es": "SNr",
   "content": {
    "kind": "text",
    "es": [
     {
      "text": "SNr (sustancia negra pars reticulata): parte de la sustancia negra, en los ganglios basales, que envía señales inhibidoras a otras zonas.",
      "cites": [
       "propuesta"
      ]
     }
    ],
    "en": [
     {
      "text": "SNr (substantia nigra pars reticulata): part of the substantia nigra, in the basal ganglia, that sends inhibitory signals to other areas.",
