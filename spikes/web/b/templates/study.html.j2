{% extends "base.html.j2" %}
{% import "macros.html.j2" as m with context %}
{% import "parts.html.j2" as p with context %}
{% block title %}{{ s.title | truncate(60) }}{% endblock %}
{% block main %}
<article class="study">
  <p><a class="back" href="{{ url('index') }}">← {{ t.back }}</a></p>
  <p class="row-meta"><span class="mono">{{ s.journal or "—" }}</span> · <span class="mono">{{ s.published_on or "—" }}</span> · <span class="type">{{ t["type_" ~ s.type] if s.type else t.type_none }}</span></p>
  <h1 class="study-title" lang="en">{{ s.title }}</h1>
  {% if lang == "es" %}<p class="muted small">{{ t.title_original }} · {{ p.gap(t, t.gap_title_es) }}</p>{% endif %}
  <div class="channels">
    {% for g in signals(s) %}
    <div class="channel-card is-{{ g.state }}">
      {{ m.channel(g, True) }}
      {% if g.notices %}<p class="mono small">{{ g.notices | join("; ") }}</p>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% if signals(s)[0].provisional %}<p>{{ p.gap(t, t.provisional_long) }}</p>{% endif %}
  <div class="panel">{{ p.summary(s, t, lang, True) }}</div>
  <p><a class="button" href="{{ s.url }}" rel="noopener" target="_blank">{{ t.original }} ↗</a></p>
  <div class="panel">{{ p.meta_table(s, t, lang, date) }}</div>
  <section class="panel" aria-labelledby="lic-h">
    <h2 id="lic-h" class="panel-h">{{ t.license }}</h2>
    {{ p.licences(licence(s), t) }}
  </section>
</article>
{% endblock %}
