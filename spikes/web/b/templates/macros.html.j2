{% import "parts.html.j2" as p with context %}

{# Each signal is a «channel»: an icon, a short label and its state, in a fixed column. #}
{% set ICON = {"preprint": "◇", "journal": "◆", "unknown": "?", "humans": "H", "animals": "A",
               "both": "H+A", "none": "✓", "retracted": "✕", "partially_retracted": "✕",
               "corrected": "!", "concern": "!"} %}

{% macro channel(g, full=False) -%}
<span class="ch ch--{{ g.key }} is-{{ g.state }}">
  <span class="ch-ico" aria-hidden="true">{{ ICON[g.state] }}</span>
  <span class="ch-txt"><span class="ch-lab">{{ g.label }}</span> {{ g.text if full else g.short }}{% if g.provisional %} <span class="prov" title="{{ t.provisional_long }}">{{ t.provisional }}</span>{% endif %}</span>
</span>
{%- endmacro %}

{% macro row(s) -%}
<li class="row" data-type="{{ s.type or 'none' }}">
  <time class="row-date" datetime="{{ s.published_on }}">{{ s.published_on or "—" }}</time>
  <div class="row-main">
    <h3 class="row-title"><a href="{{ url('study', slug(s.study_id)) }}" lang="en">{{ s.title }}</a></h3>
    <p class="row-meta"><span class="mono">{{ sj(s.journal) or "—" }}</span> · <span class="type">{{ t["type_" ~ s.type] if s.type else t.type_none }}</span></p>
    {% set sm = s.summary[lang] %}
    <p class="row-sum {{ 'is-verified' if sm.kind == 'verified' else 'is-fallback' }}"><span class="sum-k">{{ ('✓ ' ~ t.verified) if sm.kind == "verified" else t.fallback }}</span> {{ sm.sentences[0] if sm.kind == "verified" else sm.text }}</p>
  </div>
  {% for g in signals(s) %}<div class="row-sig">{{ channel(g) }}</div>{% endfor %}
</li>
{%- endmacro %}

{% macro table(items, id) -%}
<div class="table">
  <div class="thead" aria-hidden="true">
    <span>{{ t.date }}</span><span>{{ t.news }}</span><span>{{ t.sig_review }}</span><span>{{ t.sig_subject }}</span><span>{{ t.sig_integrity }}</span>
  </div>
  <ol class="rows" id="{{ id }}">
    {% for s in items %}{{ row(s) }}{% endfor %}
  </ol>
</div>
{%- endmacro %}
