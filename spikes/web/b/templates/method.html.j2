{% extends "base.html.j2" %}
{% import "macros.html.j2" as m with context %}
{% block title %}{{ t.method }}{% endblock %}
{% block main %}
<article class="prose">
  <h1>{{ t.method }}</h1>
  {% include "method_" ~ lang ~ ".html.j2" %}
</article>
<section class="examples" aria-labelledby="ex-h">
  <h2 id="ex-h" class="prose-h">{{ t.examples }}</h2>
  {{ m.table([lead, data.examples.retracted, data.examples.corrected] + (latest | selectattr("review_status", "equalto", "preprint") | list)[:1], "example-rows") }}
</section>
{% endblock %}
