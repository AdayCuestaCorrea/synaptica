{% extends "base.html.j2" %}
{% import "macros.html.j2" as m with context %}
{% import "parts.html.j2" as p with context %}
{% block title %}{{ t.news }}{% endblock %}
{% block main %}
<h1 class="hello">{{ t.news }} <span>{{ date(data.as_of, True) }}</span></h1>

<div class="bento">
  {% set f = data.facts.c %}
  <section class="tile tile--fact" aria-labelledby="fact-h">
    <h2 id="fact-h" class="tile-k">{{ t.fact }}</h2>
    {% if f %}
    <p class="fact-big">{{ t.fact_c.format(year=f.born[:4], name=f["name_" ~ lang]) }}</p>
    {% if f["desc_" ~ lang] %}<p class="fact-desc">{{ f["desc_" ~ lang] }}</p>
    {% else %}<p class="fact-desc">{{ p.gap(t, t.fact_c_gap) }} <span lang="en">({{ f.desc_en }})</span></p>{% endif %}
    <p class="fact-src">{{ t.fact_source }}: <a href="https://www.wikidata.org/wiki/{{ f.qid }}" rel="noopener" target="_blank">Wikidata {{ f.qid }}</a> · {{ f.license }}</p>
    {% else %}<p>{{ p.gap(t, "—") }}</p>{% endif %}
    <p>{{ p.gap(t, t.fact_c_note, "proposal") }}</p>
  </section>

  <a class="tile tile--week" href="{{ url('week') }}">
    <span class="tile-k">{{ t.week }} · {{ data.week }}</span>
    <span class="week-text">{{ data.weekly[lang] }}</span>
    <span class="week-cta">{{ t.week_cta }} →</span>
  </a>

  <section class="tile tile--classics" aria-labelledby="classics-h">
    <h2 id="classics-h" class="tile-k">{{ t.classics }}</h2>
    <p class="classics-ico" aria-hidden="true">☆</p>
    <p>{{ t.classics_empty }}</p>
  </section>
</div>

<section class="block" aria-labelledby="latest-h">
  <div class="block-head">
    <h2 id="latest-h">{{ t.latest }}</h2>
  </div>
  <div class="filters" role="group" aria-label="{{ t.filter_label }}" data-filters="latest-grid">
    <button type="button" data-filter="all" aria-pressed="true">{{ t.filter_all }} <span class="n">{{ latest | length }}</span></button>
    {% for k in types %}<button type="button" data-filter="{{ k }}" aria-pressed="false" class="type-{{ k }}"><span class="swatch" aria-hidden="true"></span>{{ t["type_" ~ k] }} <span class="n">{{ type_counts[k] }}</span></button>{% endfor %}
  </div>
  <p class="gaps">{{ p.gap(t, t.gap_types) }} {{ p.gap(t, t.s5_note) }}</p>
  <div class="grid" id="latest-grid">
    {% for s in latest %}{{ m.card(s) }}{% endfor %}
  </div>
  <p class="empty" data-filter-empty hidden>{{ t.filter_empty }}</p>
</section>

<section class="block" aria-labelledby="nsc-h">
  <div class="block-head">
    <h2 id="nsc-h">{{ t.nsc }}</h2>
    <p>{{ t.nsc_note }} <span class="n">{{ data.nsc | length }}</span></p>
  </div>
  <div class="rail" tabindex="0" aria-label="{{ t.nsc }}">
    {% for s in data.nsc %}{{ m.card(s, "card--rail") }}{% endfor %}
  </div>
</section>

<section class="block" aria-labelledby="media-h">
  <div class="block-head"><h2 id="media-h">{{ t.media }}</h2></div>
  <p class="gaps">{{ p.gap(t, t.gap_groups) }}</p>
  <div class="stack">{% for n in data.news %}{{ p.story(n, t, lang, date) }}{% endfor %}</div>
</section>
{% endblock %}
