{% extends "base.html.j2" %}
{% import "macros.html.j2" as m with context %}
{% import "parts.html.j2" as p with context %}
{% block title %}{{ t.week }}{% endblock %}
{% block main %}
<section class="tile tile--week tile--wide">
  <p class="tile-k">{{ t.week_of }} {{ data.week }}</p>
  <h1>{{ t.week }}</h1>
  <p>{{ p.gap(t, t.week_gap) }}</p>
  <p class="summary-kind">{{ t.fallback }}</p>
  <p class="week-text">{{ data.weekly[lang] }}</p>
</section>
<section class="block" aria-labelledby="ws-h">
  <div class="block-head"><h2 id="ws-h">{{ t.week_studies }}</h2></div>
  <div class="grid">{% for s in data.s5 %}{{ m.card(s) }}{% endfor %}</div>
</section>
{% endblock %}
