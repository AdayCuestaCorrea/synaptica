{% extends "base.html.j2" %}
{% block title %}{{ s.title | truncate(60) }}{% endblock %}
{% block main %}
<article class="study">
  <p class="back"><a href="{{ url('news') }}">← {{ t.back }}</a></p>
  {{ m.kicker(s) }}
  <h1 class="study-title" lang="en">{{ s.title }}</h1>
  {% if lang == "es" %}<p class="title-note">{{ t.title_original }} {{ m.gap("title_es") }}</p>{% endif %}
  {{ m.signals_full(s) }}
  <div class="study-grid">
    <div class="study-body">
      {{ p.summary(s, t, lang, True) }}
      {% if s.summary[lang].kind == "verified" %}<p>{{ m.gap("s5") }}</p>{% endif %}
      <p><a class="button" href="{{ s.url }}" rel="noopener" target="_blank">{{ t.original }} ↗</a></p>
    </div>
    {% if figs.get(s.study_id) %}<div class="study-fig">{{ m.figure(s, "full", lazy=False) }}</div>{% endif %}
  </div>
  {{ p.meta_table(s, t, lang, date) }}
  <section class="study-lic" aria-labelledby="lic-h">
    <h2 id="lic-h">{{ t.license }}</h2>
    {% set f = figs.get(s.study_id) %}
    {{ p.licences(licence(s) + ([t.lic_image.format(label=m.fig_label(f), lic=f.license)] if f else []), t) }}
  </section>
</article>
{% endblock %}
