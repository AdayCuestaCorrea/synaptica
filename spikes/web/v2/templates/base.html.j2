{% import "parts.html.j2" as p %}
{% import "macros.html.j2" as m with context %}
<!doctype html>
<html lang="{{ lang }}" class="style-{{ x }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{% endblock %} · SYNAPTICA</title>
<meta name="description" content="{{ t.tagline }}">
<meta name="color-scheme" content="{{ 'dark light' if x == 'n' else 'light dark' }}">
<link rel="alternate" hreflang="{{ other_lang }}" href="{{ other_url }}">
{% if x == "g" %}<link rel="preload" href="{{ fonts_root }}fonts/newsreader-latin-wght.woff2" as="font" type="font/woff2" crossorigin>
{% elif x == "n" %}<link rel="preload" href="{{ fonts_root }}fonts/atkinson-hyperlegible-latin-700.woff2" as="font" type="font/woff2" crossorigin>
{% endif %}
<link rel="stylesheet" href="{{ root }}static/{{ x }}.css">
<link rel="icon" href="{{ root }}static/favicon.svg" type="image/svg+xml">
<script src="{{ root }}static/site.js"></script>
</head>
<body>
<a class="skip" href="#main">{{ t.skip }}</a>
<p class="mock">{{ t.mock2.format(x=style) }} · <a href="#gaps">{{ t.see_gaps }} ({{ gaps | length }})</a></p>
<header class="top">
  <div class="top-in wrap">
    <a class="brand" href="{{ url('index') }}"><svg class="brand-mark" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22"><circle cx="6" cy="12" r="3"/><circle cx="18" cy="6" r="2.2"/><circle cx="18" cy="18" r="2.2"/><path d="M8.6 10.6 15.9 7M8.6 13.4l7.3 3.6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>SYNAPTICA</a>
    <span class="tools">
      <a class="tool" href="{{ other_url }}" hreflang="{{ other_lang }}" lang="{{ other_lang }}"><span aria-hidden="true">{{ t.lang_code }}</span><span class="vh">{{ t.lang_switch }}</span></a>
      <button class="tool theme-toggle" type="button" data-theme-toggle aria-live="polite"
        data-l-auto="{{ t.theme_dark_default if x == 'n' else t.theme_auto }}" data-l-light="{{ t.theme_light }}" data-l-dark="{{ t.theme_dark }}">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"/></svg> <span data-theme-label>{{ t.theme_auto }}</span>
      </button>
    </span>
  </div>
  <nav class="nav" aria-label="SYNAPTICA">
    <div class="nav-in wrap">
      <a href="{{ url('index') }}"{% if page_kind == "index" %} aria-current="page"{% endif %}>{{ t.home }}</a>
      <a href="{{ url('news') }}"{% if page_kind in ("news", "study") %} aria-current="page"{% endif %}>{{ t.news }}</a>
      <a href="{{ url('week') }}"{% if page_kind == "week" %} aria-current="page"{% endif %}>{{ t.week }}</a>
      <a href="{{ atlas_url }}" rel="noopener" target="_blank">Neuro Atlas <span class="tag">{{ t.atlas_tag }}</span></a>
      <a href="{{ url('method') }}"{% if page_kind == "method" %} aria-current="page"{% endif %}>{{ t.method }}</a>
    </div>
  </nav>
</header>
<p class="disclaimer" role="note">{{ t.disclaimer }}</p>
<main id="main" class="wrap">
{% block main %}{% endblock %}
{{ m.gap_list() }}
</main>
<footer class="footer">
  <div class="wrap footer-in">
    <p class="footer-brand">SYNAPTICA</p>
    <h2>{{ t.footer_credits }}</h2>
    <p>{{ t.footer_text }}</p>
    <p>{{ t.footer_sources }}</p>
    <p>{{ t.footer_images }}</p>
    <p>{{ t.footer_fonts.format(fonts=fonts) }}</p>
    <p>{{ t.footer_by }}</p>
    <p class="footer-disclaimer">{{ t.disclaimer }}</p>
  </div>
</footer>
</body>
</html>
