{% extends "base.html.j2" %}
{% block title %}{{ t.tagline }}{% endblock %}
{% block main %}
<section class="hero">
  <div class="hero-text">
    <h1>{{ t.tagline }}</h1>
    <p>{{ t.hero_text }}</p>
  </div>
  {{ m.drawing("purkinje", "hero-art", lazy=False) }}
</section>

<section class="today" aria-labelledby="today-h">
  <div class="sec-head">
    <h2 id="today-h">{{ t.today }}</h2>
    <span class="sec-date">{{ date(data.as_of, True) }}</span>
    <a class="sec-more" href="{{ url('news') }}">{{ t.all_news }} ({{ latest | length }}) →</a>
  </div>
  <div class="today-grid">
    <article class="lead">
      {{ m.figure(lead, "lead", lazy=False) }}
      <div class="lead-text">
        <p class="label">{{ t.lead }}</p>
        {{ m.kicker(lead) }}
        <h3 class="lead-title"><a href="{{ url('study', slug(lead.study_id)) }}" lang="en">{{ lead.title }}</a>{% if lang == "es" %} {{ m.gap("title_es") }}{% endif %}</h3>
        {{ m.chips(lead) }}
        <p class="lead-sum"><span class="label label--ok">✓ {{ t.verified }}</span> {{ lead.summary[lang].sentences[0] }} {{ m.gap("s5") }}</p>
        <p><a class="more" href="{{ url('study', slug(lead.study_id)) }}">{{ t.read_more }} →</a></p>
      </div>
    </article>
    <div class="today-list">
      {% for s in today %}{{ m.row(s) }}{% endfor %}
      <p class="list-more"><a href="{{ url('news') }}">{{ t.all_news }} →</a></p>
    </div>
    <div class="today-side">
      {{ m.fact() }}
      <a class="week-cta" href="{{ url('week') }}">
        <span class="label">{{ t.week }} · {{ data.week }}</span>
        <span class="week-cta-t">{{ data.weekly[lang] }}</span>
        <span class="more">{{ t.week_cta }} →</span>
      </a>
    </div>
  </div>
</section>

<section class="explore" aria-labelledby="explore-h">
  <div class="sec-head"><h2 id="explore-h">{{ t.explore }}</h2></div>
  <div class="tiles">
    <a class="tile tile--atlas" href="{{ atlas_url }}" rel="noopener" target="_blank">
      <span class="tile-head"><span class="tile-title">Neuro Atlas</span> <span class="tag">{{ t.atlas_tag }}</span></span>
      <span class="tile-text">{{ t.sec_atlas }}</span>
      <span class="atlas-pair">
        {% for k in ("rat", "human") %}{% set a = atlas[k] %}
        <span class="atlas-one">
          <img src="{{ img }}{{ a.file }}" alt="{{ a.short }}" loading="lazy" decoding="async">
          <span class="credit">{{ t.atlas_credit.format(atlas=a.short, lic=a.licence) }}</span>
        </span>
        {% endfor %}
      </span>
      <span class="more">{{ t.atlas_cta }} ↗</span>
    </a>
    <a class="tile tile--news" href="{{ url('news') }}">
      <span class="tile-head"><span class="tile-title">{{ t.news }}</span></span>
      <span class="tile-text">{{ t.sec_news }}</span>
      <span class="tile-n">{{ t.sec_news_n.format(latest=latest | length, nsc=data.nsc | length, media=data.news | length) }}</span>
      <span class="more">{{ t.all_news }} →</span>
    </a>
    <a class="tile tile--week" href="{{ url('week') }}">
      <span class="tile-head"><span class="tile-title">{{ t.week }}</span></span>
      <span class="tile-text">{{ t.sec_week }}</span>
      <span class="more">{{ t.week_cta }} →</span>
    </a>
    <a class="tile tile--method" href="{{ url('method') }}">
      <span class="tile-head"><span class="tile-title">{{ t.method }}</span></span>
      <span class="tile-text">{{ t.sec_method }}</span>
      <span class="more">{{ t.method }} →</span>
    </a>
  </div>
  <p class="coming"><span class="label">{{ t.coming }}</span> {{ coming | join(" · ") }}</p>
  <div class="plates">
    {{ m.drawing("cortex", "plate") }}
    {{ m.drawing("hippocampus", "plate") }}
    {{ m.drawing("cerebellum", "plate") }}
  </div>
</section>
{% endblock %}
