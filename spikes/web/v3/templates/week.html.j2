{% extends "base.html.j2" %}
{% block title %}{{ t.week }}{% endblock %}
{% block main %}
<article class="prose">
  <p class="kicker">{{ t.week_of }} {{ data.week }}</p>
  <h1>{{ t.week }}</h1>
  <p class="label">{{ t.fallback }} {{ m.gap("week") }}</p>
  <p class="week-text">{{ data.weekly[lang] }}</p>
  <h2>{{ t.week_studies }}</h2>
  <div class="list">
    {% for s in data.s5 %}{{ m.row(s) }}{% endfor %}
  </div>
</article>
{% endblock %}
