{% extends "base.html.j2" %}
{% block title %}{{ t.news }}{% endblock %}
{% block main %}
<header class="page-head">
  <h1>{{ t.news }}</h1>
  <p class="sec-date">{{ date(data.as_of, True) }}</p>
  <a class="week-strip" href="{{ url('week') }}"><span class="label">{{ t.week }}</span> {{ data.weekly[lang] }} <span class="more">{{ t.week_cta }} →</span></a>
</header>

<div class="tabs" data-tabs>
  <div class="tablist" role="tablist" aria-label="{{ t.tabs }}">
    <button role="tab" id="tab-latest" aria-controls="p-latest" aria-selected="true">{{ t.latest }} <span class="n">{{ latest | length }}</span></button>
    <button role="tab" id="tab-nsc" aria-controls="p-nsc" aria-selected="false" tabindex="-1">Nature · Science · Cell <span class="n">{{ data.nsc | length }}</span></button>
    <button role="tab" id="tab-classics" aria-controls="p-classics" aria-selected="false" tabindex="-1">{{ t.classics }} <span class="n">0</span></button>
    <button role="tab" id="tab-media" aria-controls="p-media" aria-selected="false" tabindex="-1">{{ t.media }} <span class="n">{{ data.news | length }}</span></button>
  </div>

  <section class="panel" role="tabpanel" id="p-latest" aria-labelledby="tab-latest">
    <div class="filters" role="group" aria-label="{{ t.filter_label }}" data-filters="latest-list">
      <button type="button" data-filter="all" aria-pressed="true">{{ t.filter_all }} <span class="n">{{ latest | length }}</span></button>
      {% for k in types %}<button type="button" data-filter="{{ k }}" aria-pressed="false">{{ t["type_" ~ k] }} <span class="n">{{ type_counts[k] }}</span></button>{% endfor %}
      {{ m.gap("types") }} {{ m.gap("figs") }}
    </div>
    <div class="list" id="latest-list" data-page="8">
      {% for s in latest %}{{ m.row(s) }}{% endfor %}
    </div>
    <p class="empty" data-filter-empty hidden>{{ t.filter_empty }}</p>
    <button class="more-btn" type="button" data-more="latest-list" hidden>{{ t.more_n }}</button>
  </section>

  <section class="panel" role="tabpanel" id="p-nsc" aria-labelledby="tab-nsc">
    <p class="panel-note">{{ t.nsc_note }}</p>
    <div class="list list--plain" id="nsc-list" data-page="10">
      {% for s in data.nsc %}{{ m.row(s, thumb=False) }}{% endfor %}
    </div>
    <button class="more-btn" type="button" data-more="nsc-list" hidden>{{ t.more_n }}</button>
  </section>

  <section class="panel" role="tabpanel" id="p-classics" aria-labelledby="tab-classics">
    <p class="empty-state">{{ t.classics_empty }}</p>
  </section>

  <section class="panel" role="tabpanel" id="p-media" aria-labelledby="tab-media">
    <p class="panel-note">{{ m.gap("groups") }}</p>
    <div class="stories">
      {% for n in data.news %}{{ p.story(n, t, lang, date) }}{% endfor %}
    </div>
  </section>
</div>
{% endblock %}
