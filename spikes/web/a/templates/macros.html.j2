{# Imported "with context": t, lang, url, slug, date, sj and signals come from the page. #}
{% import "parts.html.j2" as p with context %}

{# «Ficha técnica»: the three signals as a labelled line, the way a paper prints a dateline. #}
{% macro ficha(s, full=False) -%}
{% set sigs = signals(s) %}
<dl class="ficha{% if full %} ficha--full{% endif %}">
  {% for g in sigs %}
  <div class="sig sig--{{ g.key }} is-{{ g.state }}">
    <dt>{{ g.label }}</dt>
    <dd>{{ g.text if full else g.short }}{% if g.provisional %} <span class="prov" title="{{ t.provisional_long }}">{{ t.provisional }}</span>{% endif %}
      {% if full and g.notices %}<small class="notices">{{ g.notices | join("; ") }}</small>{% endif %}
    </dd>
  </div>
  {% endfor %}
</dl>
{% if full and sigs[0].provisional %}<p class="prov-long">{{ p.gap(t, t.provisional_long) }}</p>{% endif %}
{%- endmacro %}

{% macro item(s, cls="", sentences=1) -%}
<article class="item {{ cls }}" data-type="{{ s.type or 'none' }}">
  <p class="kicker">{% if s.journal %}<span class="journal">{{ sj(s.journal) }}</span> · {% endif %}<time datetime="{{ s.published_on }}">{{ date(s.published_on) or "—" }}</time>{% if s.type %} · <span class="type">{{ t["type_" ~ s.type] }}</span>{% endif %}</p>
  <h3 class="headline"><a href="{{ url('study', slug(s.study_id)) }}" lang="en">{{ s.title }}</a></h3>
  {{ ficha(s) }}
  {{ p.summary(s, t, lang) }}
</article>
{%- endmacro %}
