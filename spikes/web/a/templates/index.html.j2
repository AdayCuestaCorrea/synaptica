{% extends "base.html.j2" %}
{% import "macros.html.j2" as m with context %}
{% import "parts.html.j2" as p with context %}
{% block title %}{{ t.news }}{% endblock %}
{% block main %}
<h1 class="vh">{{ t.news }}</h1>

<a class="ribbon" href="{{ url('week') }}">
  <span class="ribbon-k">{{ t.week }}</span>
  <span class="ribbon-t">{{ data.weekly[lang] }}</span>
  <span class="ribbon-cta">{{ t.week_cta }} →</span>
</a>

<div class="front">
  <article class="lead">
    <p class="kicker"><span class="section">{{ t.lead }} · {{ t.latest }}</span> · <span class="journal">{{ sj(lead.journal) }}</span> · <time datetime="{{ lead.published_on }}">{{ date(lead.published_on) }}</time></p>
    <h2 class="lead-headline"><a href="{{ url('study', slug(lead.study_id)) }}" lang="en">{{ lead.title }}</a></h2>
    {% if lang == "es" %}<p class="title-note">{{ t.title_original }} · {{ p.gap(t, t.gap_title_es) }}</p>{% endif %}
    {{ m.ficha(lead) }}
    <div class="lead-body">
      <p class="summary-kind">✓ {{ t.verified }}</p>
      {% for line in lead.summary[lang].sentences[:3] %}<p>{{ line }}</p>{% endfor %}
      <p><a class="more" href="{{ url('study', slug(lead.study_id)) }}">{{ t.read_more }} →</a></p>
    </div>
    <p class="s5-note">{{ p.gap(t, t.s5_note) }}</p>
  </article>

  <aside class="margin-note" aria-labelledby="fact-h">
    <h2 id="fact-h">{{ t.fact }}</h2>
    {% set f = data.facts.a %}
    <blockquote><p>{{ f[lang] }}</p></blockquote>
    <p class="fact-src">{{ t.fact_source }}: <a href="{{ url('study', slug(f.study_id)) }}" lang="en">{{ by_id[f.study_id].title }}</a> ({{ sj(by_id[f.study_id].journal) }})</p>
    <p>{{ p.gap(t, t.fact_a_note, "proposal") }}</p>
  </aside>
</div>

<div class="columns">
  <section class="col col-latest" aria-labelledby="latest-h">
    <h2 id="latest-h" class="col-h">{{ t.latest }}</h2>
    <div class="filters" role="group" aria-label="{{ t.filter_label }}" data-filters="latest-list">
      <button type="button" data-filter="all" aria-pressed="true">{{ t.filter_all }} <span class="n">{{ latest | length }}</span></button>
      {% for k in types %}<button type="button" data-filter="{{ k }}" aria-pressed="false">{{ t["type_" ~ k] }} <span class="n">{{ type_counts[k] }}</span></button>{% endfor %}
    </div>
    <p class="gap-line">{{ p.gap(t, t.gap_types) }}</p>
    <div id="latest-list">
      {% for s in latest %}{% if s.study_id != lead.study_id %}{{ m.item(s) }}{% endif %}{% endfor %}
    </div>
    <p class="empty" data-filter-empty hidden>{{ t.filter_empty }}</p>
  </section>

  <section class="col col-nsc" aria-labelledby="nsc-h">
    <h2 id="nsc-h" class="col-h">{{ t.nsc }}</h2>
    <p class="col-note">{{ t.nsc_note }}</p>
    {% for s in data.nsc[:8] %}{{ m.item(s, "item--compact") }}{% endfor %}
    <details class="all">
      <summary>{{ t.more }} ({{ data.nsc | length }})</summary>
      {% for s in data.nsc[8:] %}{{ m.item(s, "item--compact") }}{% endfor %}
    </details>
  </section>

  <div class="col col-side">
    <section class="box classics" aria-labelledby="classics-h">
      <h2 id="classics-h" class="col-h">{{ t.classics }}</h2>
      <p>{{ t.classics_empty }}</p>
    </section>
    <section aria-labelledby="media-h">
      <h2 id="media-h" class="col-h">{{ t.media }}</h2>
      <p class="gap-line">{{ p.gap(t, t.gap_groups) }}</p>
      {% for n in data.news %}{{ p.story(n, t, lang, date) }}{% endfor %}
    </section>
  </div>
</div>
{% endblock %}
