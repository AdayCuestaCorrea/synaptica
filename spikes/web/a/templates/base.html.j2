{% import "parts.html.j2" as p %}
<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{% endblock %} · SYNAPTICA</title>
<meta name="description" content="{{ t.tagline }}">
<meta name="color-scheme" content="light dark">
<link rel="alternate" hreflang="{{ other_lang }}" href="{{ other_url }}">
<link rel="preload" href="{{ fonts_root }}fonts/newsreader-latin-wght.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ root }}static/a.css">
<link rel="icon" href="{{ root }}static/favicon.svg" type="image/svg+xml">
<script src="{{ root }}static/theme.js"></script>
</head>
<body>
<a class="skip" href="#main">{{ t.skip }}</a>
<p class="mock">{{ t.mock.format(x="A · Gaceta") }}</p>
<header class="masthead">
  <div class="topline wrap">
    <span class="dateline">{{ date(data.as_of, True) }}</span>
    <span class="tools">
      <a class="lang" href="{{ other_url }}" hreflang="{{ other_lang }}" lang="{{ other_lang }}"><span aria-hidden="true">{{ t.lang_code }}</span><span class="vh">{{ t.lang_switch }}</span></a>
      {{ p.theme_button(t) }}
    </span>
  </div>
  <p class="brand"><a href="{{ url('index') }}">SYNAPTICA</a></p>
  <p class="tagline">{{ t.tagline }}</p>
  <nav class="nav wrap" aria-label="SYNAPTICA">
    <a href="{{ url('index') }}"{% if page_kind in ("index", "study") %} aria-current="page"{% endif %}>{{ t.news }}</a>
    <a href="{{ url('week') }}"{% if page_kind == "week" %} aria-current="page"{% endif %}>{{ t.week }}</a>
    <a href="{{ url('method') }}"{% if page_kind == "method" %} aria-current="page"{% endif %}>{{ t.method }}</a>
  </nav>
</header>
<p class="disclaimer" role="note"><span aria-hidden="true">⚕</span> {{ t.disclaimer }}</p>
<main id="main" class="wrap">
{% block main %}{% endblock %}
</main>
<footer class="footer">
  <div class="wrap">
    <p class="brand-small">SYNAPTICA</p>
    <h2>{{ t.footer_credits }}</h2>
    <p>{{ t.footer_text }}</p>
    <p>{{ t.footer_sources }}</p>
    <p>{{ t.footer_fonts.format(fonts=fonts) }}</p>
    <p>{{ t.footer_by }}</p>
    <p class="disclaimer-foot">{{ t.disclaimer }}</p>
  </div>
</footer>
</body>
</html>
