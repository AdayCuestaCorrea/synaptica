{% extends "base.html.j2" %}
{% import "macros.html.j2" as m with context %}
{% import "parts.html.j2" as p with context %}
{% block title %}{{ t.week }}{% endblock %}
{% block main %}
<article class="prose">
  <p class="kicker">{{ t.week_of }} {{ data.week }}</p>
  <h1>{{ t.week }}</h1>
  <p class="gap-line">{{ p.gap(t, t.week_gap) }}</p>
  <p class="summary-kind">{{ t.fallback }}</p>
  <p class="week-text">{{ data.weekly[lang] }}</p>
  <h2>{{ t.week_studies }}</h2>
  {% for s in data.s5 %}{{ m.item(s) }}{% endfor %}
</article>
{% endblock %}
